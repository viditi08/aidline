# Copy this file to .env.local and fill in both keys.
# Restart `npm run dev` after changing them.
# Never commit .env.local. These keys stay on the server.

# AssemblyAI Voice Agent API key
# https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Parallel web search API key
# https://parallel.ai
PARALLEL_API_KEY=

# Twilio: lets people call or text a phone number to ask for help.
# https://console.twilio.com  (Account Info → Account SID / Auth Token)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 form, e.g. +14155550123. Needed for "text me" during calls.
TWILIO_PHONE_NUMBER=
# Public URL Twilio reaches (ngrok/Vercel). Needed so webhook signatures validate.
TWILIO_WEBHOOK_BASE_URL=
