# Copy this file to .env.local and fill in both keys.
# Restart `npm run dev` after changing them.
# Never commit .env.local. These keys stay on the server.

# AssemblyAI Voice Agent API key
# https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Parallel web search API key (optional)
# Leave empty to use Parallel's free, rate-limited search. https://platform.parallel.ai
PARALLEL_API_KEY=

# Phone calls (optional): Twilio number -> AssemblyAI Voice Agent -> /api/phone-tool.
# Long random string; AssemblyAI sends it in the x-aidline-secret header.
PHONE_TOOL_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +14155550123
TWILIO_PHONE_NUMBER=
# Public HTTPS address of this app, e.g. your tunnel or deployed URL.
PUBLIC_BASE_URL=
